# Promgent is split into two deployments.
#
#   FRONTEND  Next.js on Vercel. Serves the UI only. Holds no credentials.
#   BACKEND   Express on Render. Owns the LLM credentials and does the slow
#             work: task analysis and prompt generation.
#
# The browser calls the backend directly, because writing a prompt takes
# minutes and a serverless function would time out first. Copy this file to
# .env.local (gitignored) and fill in real values.

# ---------------------------------------------------------------------------
# FRONTEND (Vercel)
# ---------------------------------------------------------------------------

# Where the backend is deployed, e.g. https://promgent-backend.onrender.com
# No trailing slash. This value is public: it ships in the JavaScript bundle,
# so it must be a URL only, never a credential.
NEXT_PUBLIC_BACKEND_URL=http://localhost:10000

# ---------------------------------------------------------------------------
# BACKEND - Promgent's INTERNAL model
#
# Set these in the Render dashboard (production) OR in this same root
# .env.local (local development). Never commit a real value.
#
# These configure the model that powers AgentFund itself: task analysis, cost
# planning, scope optimization and prompt compilation. They are completely
# separate from the TARGET model the user picks in the UI — AgentFund can
# internally use one vendor's model while writing a prompt optimized for
# another. The internal provider is OpenAI-compatible; the default gateway is Orbio.
#
# Locally, `npm start` in server/ loads root .env.local automatically. In
# production the Render dashboard is the source, and any value set there
# always wins.
#
# Changing AGENTFUND_AI_MODEL alone is enough to switch the internal model; no
# code change is required. Any model compatible with the configured
# OpenAI-style provider works.
# ---------------------------------------------------------------------------

# Provider base URL, e.g. https://api.example.com/v1
# This is the API base, NOT the endpoint: the backend appends /chat/completions
# itself, exactly once. Do not include /chat/completions here.
AGENTFUND_AI_BASE_URL=

# API key for the internal model. Server-side only, never sent to the browser,
# never logged, never returned by any endpoint.
AGENTFUND_AI_API_KEY=

# The internal model id, e.g. z-ai/glm-5.3-flash, tencent/hy4-preview,
# anthropic/claude-sonnet-5, openai/gpt-6-astra. Examples only — use whatever
# valid id the configured provider lists. No model is hard-coded in the source.
AGENTFUND_AI_MODEL=

# Output cap for the COMBINED call, which returns the task analysis and the
# finished prompt in one response. This is the normal path, so this is the
# number that governs latency for most requests.
#
# 4500 covers a compact JSON analysis plus a genuinely detailed prompt without
# leaving room for the model to pad. Not 48000: that historical cap let a model
# spend the whole budget on reasoning and come back with nothing.
AGENTFUND_AI_MAX_TOKENS=4500

# Caps for the TWO-CALL FALLBACK path, used only if the combined response cannot
# be used. Analysis returns one compact JSON object; the prompt is the
# deliverable, roughly 500-900 words. Both stay bounded.
AGENTFUND_AI_ANALYSIS_MAX_TOKENS=1800
AGENTFUND_AI_PROMPT_MAX_TOKENS=3000

# Force the two-call path for a model that cannot return analysis and prompt
# together. Set to 0 to disable the combined call; leave unset (or 1) normally.
# The fallback also engages automatically when a combined response fails
# validation, so this is rarely needed.
# AGENTFUND_AI_COMBINED=1

# Per-attempt request budget. Every call is bounded by this via AbortController,
# so a slow provider can never hold a request open indefinitely.
AGENTFUND_AI_TIMEOUT_MS=90000

# Optional. Used only when the primary model is confirmed unavailable, and
# never as a silent substitution: switching to it is reported in the result and
# the logs. Leave empty to disable.
AGENTFUND_AI_FALLBACK_MODEL=

# Optional. Comma-separated list of browser origins allowed to call the API,
# e.g. https://inference-manager.vercel.app. Leave empty to allow any origin,
# which is fine locally but should be set in production.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# DEPRECATED - do not use
# ---------------------------------------------------------------------------

# AI_MAX_TOKENS is NO LONGER READ. It was 48000 to work around a reasoning
# model, and that single oversized cap applied to every call. It is ignored
# deliberately: honouring it would restore one huge cap for every call and make
# both stages slow again. Delete it and use AGENTFUND_AI_MAX_TOKENS (for the
# combined call), or the two AGENTFUND_AI_*_MAX_TOKENS caps for the fallback.
#
# Note: AGENTFUND_AI_MAX_TOKENS is a DIFFERENT variable and is read normally.
# The backend warns at startup while the unprefixed AI_MAX_TOKENS is present.
#
# AI_MAX_TOKENS=
