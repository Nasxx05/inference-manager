# AgentFund's INTERNAL planning model (server-side only).
# This is NOT the user's target model and is never exposed to the browser.
#
# When these are unset, AgentFund falls back to deterministic local analysis
# and still produces a full plan and prompt.

# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini