# AgentFund configuration
#
# Copy this file to .env for local development:
#   cp .env.example .env
#
# Then fill in your three values. .env is gitignored, so your key never
# gets committed. On Render, set these same three in the service's
# Environment tab instead (do NOT upload this file).

# Base URL of your OpenAI-compatible endpoint.
# Include the /v1 if your provider uses it. No trailing slash.
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://your-gateway.example.com/v1
AGENTFUND_BASE_URL=

# Your API key. Keep this secret.
AGENTFUND_API_KEY=

# The model name used for estimation and prompt writing.
# Examples: gpt-4o, deepseek-chat, qwen-plus, your-fine-tuned-model
AGENTFUND_MODEL=

# Optional: token budgets. Raise these if you use a reasoning model that
# spends most of its budget thinking before it writes the answer.
# AGENTFUND_ANALYZE_MAX_TOKENS=12000
# AGENTFUND_PROMPT_MAX_TOKENS=16000

# Optional: port for local runs. Render sets PORT automatically.
# PORT=4173
