# AgentFund is split into two deployments.
#
#   FRONTEND  Next.js on Vercel. Serves the UI only. Holds no credentials.
#   BACKEND   Express on Render. Owns the LLM credentials and does the slow
#             work: task analysis and prompt generation.
#
# The browser calls the backend directly, because writing a prompt takes
# minutes and a serverless function would time out first. Copy this file to
# .env.local (gitignored) and fill in real values.

# ---------------------------------------------------------------------------
# FRONTEND (Vercel)
# ---------------------------------------------------------------------------

# Where the backend is deployed, e.g. https://agentfund-backend.onrender.com
# No trailing slash. This value is public: it ships in the JavaScript bundle,
# so it must be a URL only, never a credential.
NEXT_PUBLIC_BACKEND_URL=http://localhost:10000

# ---------------------------------------------------------------------------
# BACKEND (Render) - set these in the Render dashboard, not here
# ---------------------------------------------------------------------------

# Provider base URL, e.g. https://api.orbio.so/api/v1
AI_BASE_URL=

# API key for the internal model. Server-side only, never sent to the browser.
AI_API_KEY=

# Model used for task analysis and for writing the final prompt,
# e.g. tencent/hy4-preview
AI_MODEL=

# The internal model is a reasoning model: it spends most of its token budget
# thinking before it writes. If this cap is too low, reasoning consumes it all
# and the response contains no content. 48000 is a safe default.
AI_MAX_TOKENS=48000

# Reasoning models are slow (observed ~2-3 minutes per prompt). This is the
# per-attempt budget; the backend retries up to 3 times.
AI_TIMEOUT_MS=240000

# Optional. Comma-separated list of browser origins allowed to call the API,
# e.g. https://agentfund.vercel.app. Leave empty to allow any origin.
ALLOWED_ORIGINS=