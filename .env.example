# AgentFund's INTERNAL planning + prompt-writing model.
# Optional: with none of these set, AgentFund uses its deterministic local
# analyzer and compiler and still returns a complete plan.
#
# Server-side only. These are never sent to the browser.
# Copy this file to .env.local (gitignored) and fill in real values.

# Provider base URL, e.g. https://api.orbio.so/api/v1
AI_BASE_URL=

# API key for the internal model
AI_API_KEY=

# Model used for task analysis and for writing the final prompt,
# e.g. tencent/hy4-preview
AI_MODEL=

# The internal model is a reasoning model: it spends most of its token budget
# thinking before it writes. If this cap is too low, reasoning consumes it all
# and the response contains no content. 16000 is a safe default.
AI_MAX_TOKENS=16000

# Reasoning models are slow (observed ~2-3 minutes per prompt). On timeout
# AgentFund falls back to the deterministic compiler rather than failing.
AI_TIMEOUT_MS=240000