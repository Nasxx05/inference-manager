{
  "name": "agentfund-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AgentFund backend: task analysis and prompt generation. Holds the LLM credentials and does the slow work.",
  "main": "dist/server/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node ./scripts/fix-esm-imports.mjs",
    "start": "node dist/server/src/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
