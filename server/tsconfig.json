{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"]
    }
  },
  // Only the entry point is listed. The shared modules under ../src are pulled
  // in through their imports, so browser-only files such as historyManager.ts
  // (which touches localStorage) never enter this build.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
